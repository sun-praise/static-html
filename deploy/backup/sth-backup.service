[Unit]
Description=sth hot backup (SQLite DB + uploads tree)
# This is a user unit; we cannot order against the system-level docker.service
# across the user/system boundary. The script uses ConditionPathExists below +
# checks `docker inspect` for a running container, so we tolerate the daemon
# not yet being ready without failing the whole boot.
ConditionPathExists=/var/run/docker.sock

[Service]
Type=oneshot
# The deploy README symlinks the backup script into ~/.local/bin/.
# Adjust ExecStart if you install it elsewhere.
ExecStart=%h/.local/bin/sth-backup.sh
StandardOutput=journal
StandardError=journal
