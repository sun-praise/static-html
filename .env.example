# Image tag to deploy. Override per host to pin a known-good version.
# - `latest` tracks the most recent build on `main` (rolling)
# - pin to a tag (e.g. `1.3.0`) for reproducible deploys and rollbacks
STH_IMAGE_TAG=latest

# Public hostname clients use to reach this instance. The server embeds it
# in the session URLs it emits, and it must match the server_name in your
# nginx site block (see deploy/nginx/example.conf).
STH_SERVER_NAME=sth.example.com

# --- Authentication (optional, default off) ---
# Enable API-key auth on the server. Off by default for backward compatibility.
# When enabled, all mutating endpoints and list/search/peers/download require
# a valid Bearer key; /s/<id>/ previews stay open unless STH_PROTECT_PREVIEWS
# is on. Manage users/keys locally with `sth user add|issue-key|...`.
STH_AUTH=false
# Additionally require a key for preview (/s/<id>/) access. Implies STH_AUTH.
STH_PROTECT_PREVIEWS=false

# --- Client credential (NOT a server setting) ---
# Used by `sth send` / `sth watch` when talking to an authenticated server.
# Set this in your shell or CI environment, not in the server container.
# STH_API_KEY=
