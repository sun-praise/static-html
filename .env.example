# Image tag to deploy. Override per host to pin a known-good version.
# - `latest` tracks the most recent build on `main` (rolling)
# - pin to a tag (e.g. `1.3.0`) for reproducible deploys and rollbacks
STH_IMAGE_TAG=latest

# Public hostname clients use to reach this instance. The server embeds it
# in the session URLs it emits, and it must match the server_name in your
# nginx site block (see deploy/nginx/example.conf).
STH_SERVER_NAME=sth.example.com
